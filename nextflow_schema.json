{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/bacpipe/master/nextflow_schema.json",
  "title": "bacpipe pipeline parameters",
  "description": "Pipeline for whole genome assembly and analysis of bacterial isolates",
  "type": "object",
  "definitions": {
    "input_output_options": {
      "title": "Input/output options",
      "type": "object",
      "fa_icon": "fas fa-terminal",
      "description": "Define where the pipeline should find input data and save output data.",
      "properties": {
        "input": {
          "type": "string",
          "format": "directory-path",
          "exists": true,
          "mimetype": "text/csv",
          "description": "Path to input directory containing sub-directories with fastq files",
          "fa_icon": "fas fa-folder-open"
        },
        "fasta": {
          "type": "string",
          "format": "directory-path",
          "exists": true,
          "description": "No need to provide input fastq files if this is set.Path to FASTA file or directory containing FASTA files. When provided, QC and assembly steps are skipped.",
          "fa_icon": "fas fa-folder-open"
        },
        "out_dir": {
          "type": "string",
          "fa_icon": "fas fa-folder-open",
          "description": "Path to output directory",
          "format": "directory-path",
          "default": "output"
        }
      }
    },
    "optional": {
      "title": "Optional",
      "type": "object",
      "description": "",
      "default": "",
      "properties": {
        "trim_adapters": {
          "type": "boolean",
          "default": false,
          "description": "Trim sequencing adapters and barcodes using porechop"
        },
        "qscore": {
          "type": "integer",
          "default": 10,
          "enum": [9,10,15,20,25,30,35,40],
          "description": "Minimum read quality score threshold for filtering"
        },
        "medaka_model": {
          "type": "string",
          "default": "bacteria",
          "description": "Select basecalling model for medaka genome polishing"
        },
        "gsize": {
          "type": "string",
          "default": "auto",
          "description": "Enter the estimated genome size."
        },
        "lineage": {
          "type": "string",
          "default": "bacteria_odb10",
          "description": "Select the appropriate lineage for busco genome completeness estimation"
        },
        "annotate": {
          "type": "boolean",
          "default": false,
          "description": "Enable genome annotation using Bakta"
        },
        "bakta_db": {
          "type": "string",
          "default": "/data/referenceDB/bakta_db/bakta_db-light",
          "description": "Path to Bakta database directory",
          "format": "directory-path"
        }
      }
    }
  },
  "allOf": [
    { "$ref": "#/definitions/input_output_options" },
    { "$ref": "#/definitions/optional" },
    {
      "oneOf": [
        {
          "required": ["input", "out_dir"]
        },
        {
          "required": ["fasta", "out_dir"]
        }
      ]
    }
  ]
}